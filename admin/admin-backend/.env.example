# Admin Backend — Environment Variables Template
# Copy this file to .env and fill in your values. Never commit real secrets.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Use a MongoDB Atlas connection string in production.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
CORS_ORIGIN=https://dealeradmin.example.com,https://dealer.example.com

# ── System Settings encryption ───────────────────────────────────────────────
# 32-byte key (64 hex chars) used to encrypt sensitive CIBIL credentials at rest.
SETTINGS_ENC_KEY=your_64_hex_char_32_byte_key_here

# ── Mobile Backend gateway (server-to-server) ────────────────────────────────
# Shared secret the Mobile Backend sends as the x-internal-api-key header when
# forwarding applications to POST /api/applications. Must match the Mobile
# Backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=your_strong_random_secret_here

# ── Local File Storage (Phase 7 — replaces Cloudinary) ───────────────────────
# Absolute path to the shared uploads root (must match the Mobile Backend).
# Leave unset in dev to default to the repo-level uploads/ directory.
UPLOADS_ROOT=/var/www/uploads
