# Admin Frontend (Vite) — Environment Variables Template
# Copy to .env (or .env.development / .env.production). Only VITE_* vars are
# exposed to the browser — never put secrets here.

# Base URL of the Admin Backend API.
#   Development: http://localhost:5001/api
#   Production:  https://dealeradmin.example.com/api
VITE_API_BASE_URL=http://localhost:5001/api
