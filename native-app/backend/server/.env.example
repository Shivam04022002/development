# ── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# ── Local File Storage (Phase 7 — replaces Cloudinary) ───────────────────────
# Absolute path to the shared uploads root (must match the Admin Backend).
# Leave unset in dev to default to the repo-level uploads/ directory.
UPLOADS_ROOT=/var/www/uploads
# Absolute public base used to build file URLs returned to the mobile app.
FILE_PUBLIC_BASE=https://dealerapi.yourdomain.com

# ── Admin Backend Integration (gateway) ──────────────────────────────────────
# Base URL of the Admin Backend (no trailing slash). The Mobile Backend forwards
# submissions to POST {ADMIN_BACKEND_URL}/api/applications.
ADMIN_BACKEND_URL=https://adminapi.yourdomain.com

# Shared secret between Mobile Backend and Admin Backend.
# Set the same value in the Admin Backend's .env as INTERNAL_API_KEY.
# Sent as the x-internal-api-key header on forwarded requests.
INTERNAL_API_KEY=your_strong_random_secret_here
