# Dealer Mobile App (Expo) — Environment Variables Template
# Copy to .env to pin the backend this machine builds against.
#
# `config.js` reads EXPO_PUBLIC_API_BASE; Expo inlines every EXPO_PUBLIC_*
# variable into the JS bundle at build time. EAS cloud builds take the value
# from the build profile's `env` block in eas.json instead of this file. When
# the variable is unset, config.js falls back to its DEFAULT_ENVIRONMENT
# (development → the V2 server), so a plain local build already targets V2.
#
# Nothing secret belongs here: EXPO_PUBLIC_* values are embedded in the bundle
# and readable by anyone holding the APK.

# Base URL of the Mobile Backend API (no trailing slash).
#   Development (V2) : https://v2api.surjitfinance.com
#   Production  (V1) : https://dealerapi.surjitfinance.com
#   Local LAN        : http://<your-lan-ip>:5000
EXPO_PUBLIC_API_BASE=https://v2api.surjitfinance.com
