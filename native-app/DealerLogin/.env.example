# Dealer Mobile App (Expo) — Environment Variables Template
# Copy to .env and fill in values. Do not commit real values.
#
# NOTE: the API base URL is currently selected in `config.js` (IS_PRODUCTION
# toggle). These variables are provided for teams that wire the app to read
# from the environment via app.config / expo-constants.

# Base URL of the Mobile Backend API.
#   Local dev: http://<your-lan-ip>:5000
#   Production: https://dealerapi.example.com
EXPO_PUBLIC_API_BASE=https://dealerapi.example.com
